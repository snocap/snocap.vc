{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "workers"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "components/*": ["src/components/*"],
      "layouts/*": ["src/layouts/*"],
      "pages/*": ["src/pages/*"],
      "styles/*": ["src/styles/*"],
      "api/*": ["src/api/*"],
      "data/*": ["src/data/*"],
      "utils/*": ["src/utils/*"]
    }
  }
}
